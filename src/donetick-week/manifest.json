{
  "name": "Donetick Next 7 Days",
  "description": "Tasks due over the next seven calendar days, starting tomorrow.",
  "icon": "mdi:calendar-week",
  "minSize": {
    "h": 3,
    "w": 3
  },
  "maxSize": {
    "h": 12,
    "w": 12
  },
  "defaultSize": {
    "h": 5,
    "w": 4
  },
  "sdkVersion": "^1.23.1",
  "capabilities": [
    {
      "domain": "todo",
      "access": "read"
    },
    {
      "domain": "donetick",
      "services": [
        "complete_task"
      ],
      "access": "control"
    }
  ],
  "configVersion": 4,
  "version": "0.4.0",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "title": {
        "title": "Title",
        "description": "Optional display name override",
        "type": "string"
      },
      "list": {
        "default": [],
        "domain": "todo",
        "title": "Donetick task list (optional)",
        "description": "Leave blank to detect All Tasks automatically. Choose a list if you have multiple Donetick connections.",
        "singleSelect": true,
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "list"
    ],
    "additionalProperties": {}
  },
  "defaultConfig": {
    "list": []
  }
}
